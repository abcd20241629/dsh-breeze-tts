{
  "name": "@dsh-external/dsh-breeze-tts",
  "version": "0.2.1",
  "description": "本机 Breeze TTS 2 配音级语音合成：直连 T8star 的 Python 后端 /ws/generate，按卡片绑定参考音频锁音色，wav 落盘并播放",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.5"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./client/service": "./lib/client.js",
    "./client/api": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "tts",
    "breeze-tts",
    "voice"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    },
    "manifestVersion": 1
  }
}
